<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal world for eyeballing model://indoor_dev_drone. Copied from
  default.sdf and changed in exactly three ways:

    1. <grid>true</grid> instead of false, so the 5 m offset is countable
       against the grid squares rather than taken on trust.
    2. The <include> at the bottom, at x=5 y=5.
    3. World name is indoor_dev_drone, matching the filename - PX4_GZ_WORLD
       looks the world up by filename, but gz's own tooling reports the
       <world name>, and having the two disagree makes topic names confusing.

  Physics, magnetic field, lighting and spherical_coordinates are byte-identical
  to default.sdf on purpose: if the drone behaves differently here than in the
  default world, it is the model's doing, not the world's.

  SPAWN HEIGHT
  ------------
  z=0.05, not 0. indoor_dev_drone's base_link is at the underside of the frame
  (visual pose z=0 puts the mesh bottom on the link origin), so a z=0 spawn
  starts the collision box in exact contact with the ground plane and ODE has
  to resolve a zero-depth contact on the first step - which shows up as a jitter
  or a small hop. 5 cm of air lets it settle cleanly instead. The model is
  <static>false</static> with a placeholder inertial, so it WILL fall and rest;
  that is expected, not a bug.

  There are no rotors or plugins on this model, so nothing here flies. This
  world is for looking at the mesh - checking scale, orientation and the baked
  face colours - not for flying a PX4 airframe.
-->
<sdf version="1.9">
  <world name="indoor_dev_drone">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Resolved off GZ_SIM_RESOURCE_PATH, which PX4's gz_env.sh points at
         Tools/simulation/gz/models. Same mechanism aruco.sdf uses for its
         arucotag_N includes. -->
    <include>
      <name>indoor_dev_drone</name>
      <uri>model://indoor_dev_drone</uri>
      <pose>5 5 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
