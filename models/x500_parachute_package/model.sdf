<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_parachute_package'>
    <self_collide>false</self_collide>

    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Parachute payload: the supply crate with its canopy STOWED.
         crate_chute names its link "link", so the DetachableJoint below
         resolves. (model://parachute_package does NOT work here - its links are
         "base_link" and "parachute_small::chute", so <child_link>link</child_link>
         would find nothing, the joint would never be created, and the payload
         would fall off at spawn.)

         Swap this uri for model://mortar_chute to get the mortar round back -
         it exposes the same "link", so nothing else here changes. The mortar
         carries a contact sensor and is scored by payload_impact_scorer.py;
         the crate deliberately is not.

         The 3.14 pitch turns crate_chute's -Z, which the canopy is built along,
         into world up. While stowed the canopy has no collision, no drag and no
         visual at all, so it neither touches, slows nor hides the vehicle. -->
    <include>
      <uri>model://crate_chute</uri>
      <name>parachute_payload</name>
      <pose>0.1 0 0.11 0 3.14 0</pose>
    </include>

    <!-- Holds the payload rigidly until detach message arrives -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>base_link</parent_link>
      <child_model>parachute_payload</child_model>
      <child_link>link</child_link>
    </plugin>
  </model>
</sdf>
