<?xml version="1.0"?>
<model>
  <name>grass_ground</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>200x200 m visual-only grass ground, built from a 5x5 grid of grass_patch
  tiles. Include it as a unit alongside a world's own ground_plane, which supplies the
  collision surface. Resize by editing this model, not the worlds.</description>
</model>
