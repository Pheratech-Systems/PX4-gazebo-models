<?xml version="1.0"?>
<model>
  <name>Parachute Canopy (visual only)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>leonciohermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>

  <description>
    Visual-only canopy spawned by custom::ParachuteSystem when a parachute
    deploys. Static, collision-less and massless; the plugin drives its pose.
    Uses the mesh from model://parachute_small.
  </description>
</model>
