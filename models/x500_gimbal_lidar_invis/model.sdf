<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <!-- x500_gimbal_lidar_invis - the survey/detection rig, with the airframe removed
       from the gimbal camera's image.

       Same as x500_gimbal_lidar except it mounts model://gimbal_invis instead of
       model://gimbal. That gimbal's camera sets <visibility_mask> to bits 2..26
       (0x07FFFFFC), and the x500_base airframe visuals set flags 0x08000003 (bit 27
       plus the two GUI bits), which share no bit with the mask — so the frame and its
       T-bar landing gear are not rendered into this camera. x500_gimbal and
       x500_gimbal_lidar are untouched and still see their own frames.

       The legs still exist physically - they are separate <collision> elements in
       x500_base - so ground contact, landing and the flight model are unchanged. -->
  <model name='x500_gimbal_lidar_invis'>
    <self_collide>false</self_collide>

    <include merge='true'><uri>model://x500</uri></include>

    <!-- Gimbal (keeps joint names + command topics the bridge uses; only the camera's
         visibility_mask differs from model://gimbal) -->
    <include merge='true'>
      <uri>model://gimbal_invis</uri>
      <pose>0 0 0.26 0 0 3.14</pose>
    </include>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>

    <!-- Lidar rangefinder, RE-PARENTED onto the gimbal end-effector.
         Link name + sensor name MUST stay lidar_sensor_link / lidar for the bridge.
         Note: this ray is NOT masked, so at extreme gimbal pitch-up it can still
         range off the airframe the camera no longer shows. Irrelevant near nadir,
         where the frame is well off-axis. -->
    <joint name="lidar_gimbal_joint" type="fixed">
      <parent>camera_link</parent>       <!-- was base_link in x500_lidar_down -->
      <child>lidar_sensor_link</child>
    </joint>
    <link name="lidar_sensor_link">
      <!-- Match the camera sensor's orientation so the ray (+X) points where the camera looks.
           Camera sensor pose rel. to camera_link is "-0.074 0 -0.162 0 0 3.14" — start there and tune. -->
      <pose relative_to="camera_link">-0.074 0 -0.162 0 0 3.14</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name='lidar' type='gpu_lidar'>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution>
                        <min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical>  <samples>1</samples><resolution>1</resolution>
                        <min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.1</min><max>1000.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
