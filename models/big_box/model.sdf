<?xml version="1.0" ?>
<!--
  Ported from gazebo-classic:
  Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/big_box

  Carried over only because model://parachute_package uses this model's MESH
  (model://big_box/meshes/big_box.dae, rescaled to 0.125) as its crate visual.
  The model itself is a standalone 40 kg 1.2 x 0.8 x 1.5 m crate and nothing in
  this repo instantiates it.

  Changes made for gz-sim 8 (Harmonic):
    - <sdf version> 1.5 -> 1.9
    - model name "Big box" -> "big_box". The space is legal in SDF but makes a
      scoped entity name ("Big box::link") awkward to address from gz topics
      and services. Nothing referenced the model by name, only by mesh URI.
  Everything else is byte-for-byte the classic model, including the ODE-only
  <surface><contact><ode> tuning, which DART ignores.

  The .dae references its textures as ../materials/textures/*, so the
  meshes/ + materials/textures/ layout has to stay as-is. The classic model's
  .pdn files (Paint.NET sources for three of the PNGs) were not copied.
-->
<sdf version="1.9">
  <model name="big_box">
    <pose>0 0 0.75  0 0 0</pose>
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>40.0</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1</iyy>
          <iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
              <size>1.20 0.80 1.50</size>
          </box>
        </geometry>
	<surface>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://big_box/meshes/big_box.dae</uri>
          </mesh>
	</geometry>
      </visual>
    </link>
  </model>
</sdf>
