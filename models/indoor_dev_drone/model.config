<?xml version="1.0"?>
<model>
  <name>indoor_dev_drone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Pheratech Systems</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    Indoor development drone airframe shell. Wraps the SolidWorks-exported
    drone.dae (the same mesh drone.urdf serves to RViz) as a single rigid
    base_link so it can be spawned in Gazebo. Visual only in substance:
    no rotors, no joints, no plugins - collision is a bounding box and the
    inertial is a placeholder box inertia, not a measured one.
  </description>
</model>
