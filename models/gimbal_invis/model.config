<?xml version="1.0"?>
<model>
  <name>gimbal_invis</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Leoncio Hermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    CGO3 gimbal whose camera does not render the airframe it is mounted on, so the
    x500's T-bar landing gear cannot occlude a detection. Reuses model://gimbal's
    meshes; keep model.sdf in sync with models/gimbal/model.sdf.
  </description>
</model>
