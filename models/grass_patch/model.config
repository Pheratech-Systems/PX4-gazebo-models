<?xml version="1.0"?>
<model>
  <name>grass_patch</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>40 m visual-only grass tile, sharing grass_field's texture. Sized so a
  3x3 grid covers exactly 120x120 m; pair it with a world's existing ground_plane,
  which supplies the collision surface.</description>
</model>
