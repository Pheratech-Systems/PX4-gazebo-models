<?xml version="1.0"?>
<model>
  <name>x500_depth_lidar_front</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Leoncio Hermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    x500 with the OakD-Lite forward depth camera (as in x500_depth) plus a forward-facing
    LW20 single-point lidar rangefinder (as in x500_lidar_front). Sensor mounts are
    unchanged from those two models, so depth output and the distance_sensor topic behave
    exactly as they do on the single-sensor rigs.
  </description>
</model>
