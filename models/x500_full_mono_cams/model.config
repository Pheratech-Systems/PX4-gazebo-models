<?xml version="1.0"?>
<model>
  <name>x500_full_mono_cams</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Leoncio Hermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    x500 with five model://mono_cam instances for full coverage: forward, aft, down,
    left and right. Cameras are nested includes (cam_front / cam_aft / cam_down /
    cam_left / cam_right), so each image topic carries an extra model/&lt;name&gt; level
    rather than the flat path x500_mono_cam produces. Poses are relative_to base_link
    in the gz FLU frame, where +Y is LEFT. Five 1280x960 cameras at 30 Hz is GPU-heavy;
    see model.sdf for the numbers.
  </description>
</model>
