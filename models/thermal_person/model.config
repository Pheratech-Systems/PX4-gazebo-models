<?xml version="1.0"?>
<model>
  <name>thermal_person</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Leoncio Hermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    A ~1.79 m adult built from primitives, carrying a segmented thermal signature for
    LWIR search-and-rescue testing: exposed head and hands near skin temperature,
    clothed torso cooler, boots near ambient. Built for model://thermal_cam.

    Primitives on purpose, not a placeholder for a mesh. LWIR resolves no surface
    texture, so what a thermal detector sees is silhouette plus temperature, and both
    are exact here. Use a mesh model only if the same scene also has to look right to
    an RGB camera.

    Authored upright with the origin between the feet, facing +x. To lay it supine
    (face up), rotate pitch -1.5708 and lift z by about 0.13; see model.sdf.
  </description>
</model>
