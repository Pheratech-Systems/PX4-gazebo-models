<?xml version="1.0" encoding="UTF-8"?>
<!--
  Intel RealSense D435 RGB-D camera, ported from Clearpath's clearpath_sensors_description
  (intel_realsense.urdf.xacro with intel/d435.urdf.xacro).

  Image values match Clearpath's simulator: 640 x 480 color and depth, 1.25 rad horizontal
  FOV, 0.3-100 m clip, 30 Hz, no noise. A real D435 depth range is about 0.3-10 m.
  The body is a 90 x 25 x 25 mm box: the realsense2_description mesh is 15.8 MB.

  The model origin is the bottom tripod screw; the camera looks along +x.
  Topics (default Gazebo naming), under .../link/realsense_d435_link/sensor/realsense_d435/:
    image         gz.msgs.Image (color)
    depth_image   gz.msgs.Image (32-bit float, metres)
    points        gz.msgs.PointCloudPacked
    camera_info   gz.msgs.CameraInfo
-->
<sdf version='1.9'>
  <model name='realsense_d435'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="realsense_d435_link">
      <inertial>
        <pose>0.0106 0 0.0125 0 0 0</pose>
        <mass>0.072</mass>
        <inertia>
          <ixx>0.0000524</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000075</iyy>
          <iyz>0</iyz>
          <izz>0.0000524</izz>
        </inertia>
      </inertial>
      <visual name="realsense_d435_visual">
        <pose>0.0106 0 0.0125 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02505 0.090 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.62 1</ambient>
          <diffuse>0.6 0.6 0.62 1</diffuse>
        </material>
      </visual>
      <collision name="realsense_d435_collision">
        <pose>0.0106 0 0.0125 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02505 0.090 0.025</size>
          </box>
        </geometry>
      </collision>
      <!-- At the depth origin (left infrared camera), as in realsense2_description -->
      <sensor name="realsense_d435" type="rgbd_camera">
        <gz_frame_id>realsense_d435_link</gz_frame_id>
        <pose>0.0106 0.0175 0.0125 0 0 0</pose>
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.3</near>
            <far>100</far>
          </clip>
          <optical_frame_id>realsense_d435_color_optical_frame</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
