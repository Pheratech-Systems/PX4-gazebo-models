<?xml version="1.0"?>
<model>
  <name>Mortar Round with Parachute</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>leonciohermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>

  <description>
    Droppable 60 mm mortar round with a parachute that deploys on a timer after
    release. The canopy is jointed from load; custom::ParachuteSystem gates the
    aerodynamics, so it produces no force until triggered.

    Depends on model://detailed_mortar for the round and on
    model://parachute_small for the canopy mesh. Requires the PX4-built
    libParachuteSystem.so to be on GZ_SIM_SYSTEM_PLUGIN_PATH (gz_env.sh sets
    this via PX4_GZ_PLUGINS).
  </description>
</model>
