<?xml version="1.0"?>
<model>
  <name>x500_gimbal_lidar_front</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Leoncio Hermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    X500 with a lidar + gimbal camera, gimbal mounted 0.1 m forward. Known: shifts CG
    16.2 mm and jolts forward on takeoff, and only buys 0.3 deg of roll tolerance against
    landing-gear occlusion. See model.sdf for the measurements.
  </description>
</model>
