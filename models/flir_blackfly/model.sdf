<?xml version="1.0" encoding="UTF-8"?>
<!--
  FLIR Blackfly S camera with lens, ported from Clearpath's clearpath_sensors_description
  (flir_blackfly.urdf.xacro).

  Image values match Clearpath's simulator: 720 x 540 RGB, 60 deg horizontal FOV,
  0.5-300 m clip, 30 Hz (Clearpath's default fps), gaussian noise stddev 0.007.
  Clearpath's file also rotates the camera inside <camera><pose>; that is left out here
  so the camera looks forward along +x, the way the lens points.

  The model origin is the bottom of the camera body; the lens points along +x.
  Topics (default Gazebo naming):
    .../link/flir_blackfly_link/sensor/flir_blackfly/image        gz.msgs.Image
    .../link/flir_blackfly_link/sensor/flir_blackfly/camera_info  gz.msgs.CameraInfo
-->
<sdf version='1.9'>
  <model name='flir_blackfly'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="flir_blackfly_link">
      <!-- Body 0.03 kg plus lens 0.05 kg, Clearpath's values (approximate) -->
      <inertial>
        <pose>0.02 0 0.0143 0 0 0</pose>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="flir_blackfly_body_visual">
        <pose>0 0 0.01425 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://flir_blackfly/meshes/flir_blackfly.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="flir_blackfly_lens_visual">
        <pose>0.04685 0 0.01425 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.016</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="flir_blackfly_body_collision">
        <pose>0.003 0 0.0145 0 0 0</pose>
        <geometry>
          <box>
            <size>0.047758 0.029 0.029</size>
          </box>
        </geometry>
      </collision>
      <collision name="flir_blackfly_lens_collision">
        <pose>0.04685 0 0.01425 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.016</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="flir_blackfly" type="camera">
        <gz_frame_id>flir_blackfly_link</gz_frame_id>
        <pose>0.06685 0 0.01425 0 0 0</pose>
        <camera>
          <horizontal_fov>1.0471975512</horizontal_fov>
          <image>
            <width>720</width>
            <height>540</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.5</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <optical_frame_id>flir_blackfly_color_optical_frame</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
  </model>
</sdf>
