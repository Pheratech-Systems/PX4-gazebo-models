<?xml version="1.0"?>

<model>
  <name>Parachute Package</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Jaeyoung Lim</name>
    <email>jalim@ethz.ch</email>
  </author>

  <description>
    A package that has a parachute attached, so it can be dropped from a vehicle

    Ported to gz-sim 8 from PX4's gazebo-classic model of the same name
    (Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/parachute_package).
    Depends on model://parachute_small for the canopy and on
    model://big_box for the crate mesh.
  </description>

</model>
