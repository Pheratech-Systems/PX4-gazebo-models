<?xml version="1.0" ?>
<!--
  Ported from gazebo-classic:
  Tools/simulation/gazebo-classic/sitl_gazebo-classic/models/parachute_package

  A 1 kg box slung under model://parachute_small - i.e. a payload that descends
  under an already-open canopy. There is no trigger here and never was: the
  canopy is aerodynamically live from spawn, so releasing this package from a
  carrier gives canopy descent immediately, with no free-fall phase.

  Changes made for gz-sim 8 (Harmonic):
    - <sdf version> 1.5 -> 1.9
    - <use_parent_model_frame>1</use_parent_model_frame> removed - the element
      was deleted in SDF 1.7. Its replacement is the expressed_in attribute on
      //axis/xyz, so the axis is now written <xyz expressed_in="__model__">,
      which is what use_parent_model_frame meant.
  Everything else is byte-for-byte the classic model.

  Two classic quirks deliberately kept rather than "fixed", so this stays a
  straight port - both are inert under gz-sim's default DART engine:
    - parachute_joint is a revolute with lower=upper=0 (a locked revolute)
      rather than a fixed joint. If DART ever lets it drift, <joint
      type='fixed'> with the same parent/child is the drop-in replacement.
    - <surface><contact><ode> holds max_vel/min_depth, which are ODE-only
      tuning and are ignored by DART.
-->
<sdf version="1.9">
  <model name="parachute_package">
    <include>
      <uri>model://parachute_small</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>
    <link name="base_link">
      <pose>0 0 0  0 0 0</pose>
      <inertial>
        <pose>0 0 0  0 0 0</pose>
        <mass>1.00</mass>
        <inertia>
          <ixx>0.010000</ixx>
          <ixy>0.000000</ixy>
          <ixz>0.000000</ixz>
          <iyy>0.010000</iyy>
          <iyz>0.000000</iyz>
          <izz>0.010000</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.3  0 0 0</pose>
        <geometry>
          <box>
              <size>0.15 0.1 0.18</size>
          </box>
        </geometry>
	      <surface>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.3  0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.125 0.125 0.125</scale>
            <uri>model://big_box/meshes/big_box.dae</uri>
          </mesh>
	      </geometry>
      </visual>
    </link>
    <joint name='parachute_joint' type='revolute'>
      <child>base_link</child>
      <parent>parachute_small::chute</parent>
      <axis>
        <xyz expressed_in="__model__">1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    </model>
</sdf>
