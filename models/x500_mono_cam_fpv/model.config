<?xml version="1.0"?>
<model>
  <name>x500_mono_cam_fpv</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Pheratech Systems</name>
    <email>lhermosillo@pheratech.com</email>
  </author>
  <description>
    FPV-racing-style quadrotor: x500 airframe geometry with high-thrust motors
    (~6:1 thrust-to-weight) and a nose-mounted mono camera pitched 45 deg upward,
    so the camera looks at the horizon while the airframe is pitched 45 deg nose
    down in fast forward flight. Still needs some tuning
  </description>
</model>
