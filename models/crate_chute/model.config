<?xml version="1.0"?>
<model>
  <name>Supply Crate with Parachute</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>leonciohermosillo</name>
    <email>lhermosillo@pheratech.com</email>
  </author>

  <description>
    Droppable supply crate with a parachute that deploys on a timer after
    release. The crate variant of mortar_chute: no contact sensor, so it is not
    picked up by payload_impact_scorer.py.

    Depends on model://big_box for the crate mesh and model://parachute_canopy
    for the deployed canopy. Requires the PX4-built libParachuteSystem.so on
    GZ_SIM_SYSTEM_PLUGIN_PATH (gz_env.sh sets this via PX4_GZ_PLUGINS).
  </description>
</model>
